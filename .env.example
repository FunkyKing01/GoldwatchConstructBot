# Copy this file to .env and fill it in.

# Bot token from https://discord.com/developers/applications -> your app -> Bot -> Reset Token
DISCORD_TOKEN=

# Optional: your server's ID. Not needed any more; the bot has no slash commands.
GUILD_ID=

# Web control panel. No password is needed while it is only reachable from this computer.
# If you open it to other devices (PANEL_HOST below), set one here, or the bot prints a random one each start.
PANEL_PASSWORD=
# Optional second password that only shows the Receipts and Totals tabs.
PANEL_VIEW_PASSWORD=
PANEL_PORT=3000
# 127.0.0.1 = this computer only. 0.0.0.0 = also other devices on your network.
PANEL_HOST=127.0.0.1
